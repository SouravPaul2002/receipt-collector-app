PORT=5000
DATABASE_URI=your_mongodb_connection_string

ACCESS_TOKEN_SECRET=your-access-token-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRY=7d
CORS_ORIGIN=http://localhost:3000

# google cloud console credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# redirect URIs
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5000/api/auth/google/drive/callback

# frontend URL
FRONTEND_URL=http://localhost:3000

# encryption key for sensitive tokens (AES-256-GCM 32-byte hex)
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-key

# email
EMAIL_USER=your-email@example.com
EMAIL_APP_PASSWORD=your-gmail-app-password
